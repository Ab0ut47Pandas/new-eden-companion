# Create a PKCE application at https://developers.eveonline.com/applications
EVE_CLIENT_ID=
EVE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Used in the ESI User-Agent so CCP can contact the app owner if needed.
ESI_CONTACT=your-email@example.com
ESI_COMPATIBILITY_DATE=2026-08-12

# Optional. Defaults to ./data/eve-companion.db
# DATABASE_PATH=D:/Eve Companion/data/eve-companion.db
